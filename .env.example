# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner .env.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=livraison
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=livraison
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Serveur XMPP (SPADE) ---
XMPP_HOST=localhost
XMPP_PORT=5222
XMPP_DOMAINE=localhost
XMPP_MOT_DE_PASSE_AGENTS=changez-moi

# --- Moteur d'itinéraires ---
OSRM_URL=http://localhost:5000

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# --- Ajouts version 0.2 ---
# « sql » (PostgreSQL, normal) ou « memoire » (démonstration sans base de données)
DEPOT=sql
# Mode développement : le code de connexion « SMS » est renvoyé par l'API (aucun SMS réel).
MODE_DEV=true
# Comptes créés au démarrage (numéros de téléphone)
ADMIN_TELEPHONE=0700000000
REPARTITEUR_TELEPHONE=0700000001
# Délai laissé au livreur pour accepter une course (secondes)
DELAI_CONFIRMATION_S=30
